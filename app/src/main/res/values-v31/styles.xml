<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TurboLiteTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#00D4FF</item>
        <item name="android:navigationBarColor">#070B16</item>
        <item name="android:statusBarColor">#070B16</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#070B16</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_turbolite</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0B1930</item>
        <item name="android:postSplashScreenTheme">@style/TurboLiteTheme</item>
    </style>
</resources>
